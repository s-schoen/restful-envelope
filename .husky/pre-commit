git diff --cached --name-only --diff-filter=ACMR -z -- \
  "*.js" "*.jsx" "*.mjs" "*.cjs" "*.ts" "*.tsx" "*.mts" "*.cts" |
  xargs -0 sh -c '[ "$#" -eq 0 ] || pnpm exec oxlint -- "$@"' sh

