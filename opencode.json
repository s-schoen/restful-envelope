      "bash .opencode/skills/release-package/scripts/verify-publication.sh *$*": "ask",
      "bash .opencode/skills/release-package/scripts/verify-publication.sh *;*": "ask",
      "bash .opencode/skills/release-package/scripts/verify-publication.sh *&*": "ask",
      "bash .opencode/skills/release-package/scripts/verify-publication.sh *|*": "ask",
      "bash .opencode/skills/release-package/scripts/verify-publication.sh *>*": "ask",
      "bash .opencode/skills/release-package/scripts/verify-publication.sh *<*": "ask",
      "bash .opencode/skills/release-package/scripts/verify-publication.sh *`*": "ask",
