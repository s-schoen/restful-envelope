      "gh release delete *": "ask",
      "gh run rerun *": "ask",
      "git push *": "ask",
      "*gh release create*": "deny",
      "*gh release new*": "deny",
      "*gh release delete*": "deny",
      "*gh release edit*": "deny",
      "*gh run rerun*": "deny",
      "*git push*": "deny"
